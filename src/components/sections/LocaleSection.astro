---
import Prompt from '../Prompt.astro';

const { lang, t } = Astro.props;
---
<section>
  <Prompt cmd="locale -a" />
  <div class="tui-grid">
    <span class="file">en_US.utf8</span>
    {lang === 'en' ? (
      <span style="color: var(--text-main); font-family: var(--font-prose); font-size: 1.15rem; font-weight: bold;">{t.ui.langEn}</span>
    ) : (
      <a href={`${import.meta.env.BASE_URL}/en`.replace(/\/+/g, '/')} class="hover-link" style="color: var(--text-muted); font-family: var(--font-prose); font-size: 1.15rem;">{t.ui.langEn}</a>
    )}

    <span class="file">ru_RU.utf8</span>
    {lang === 'ru' ? (
      <span style="color: var(--text-main); font-family: var(--font-prose); font-size: 1.15rem; font-weight: bold;">{t.ui.langRu}</span>
    ) : (
      <a href={`${import.meta.env.BASE_URL}/ru`.replace(/\/+/g, '/')} class="hover-link" style="color: var(--text-muted); font-family: var(--font-prose); font-size: 1.15rem;">{t.ui.langRu}</a>
    )}
  </div>
</section>
